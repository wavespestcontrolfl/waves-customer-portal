{
  "note": "Worked cases for the misting spray-rate math. Read by server/tests/misting-calibration-math.test.js and client/src/lib/mistingCalibrationMath.test.js so the two copies of the math cannot drift. productKey picks the product in shared/misting-products.json (null = an unknown product). refillCases: a refill's mix against a calibration already at its daily cap (47.5 fl oz); capFlOz is the cap at the refill's mix and mixInLabelRange is true when a known product's refill mix is inside its label range with 2% slack (always true for an unknown product).",
  "cases": [
    {
      "name": "Sector at the label mix (64 in 55 gal): typical system, well under the limit",
      "input": {
        "tankGallons": 55,
        "nozzleCount": 40,
        "riserCount": 4,
        "nozzleFlowFlOzPerMin": 1.0,
        "cycleSeconds": 45,
        "mistTimes": [
          "06:30",
          "19:30",
          "22:30"
        ],
        "treatedAreaSqFt": 6000,
        "treatedHeightFt": 8,
        "labelMaxFlOzPer1000CuFtDay": 9.5,
        "concentrateFlOzPerTank": 64,
        "productKey": "sector"
      },
      "expected": {
        "emitters": 44,
        "treatedVolumeCuFt": 48000.0,
        "outputFlOzPerCycle": 33.0,
        "dailyOutputFlOz": 99.0,
        "strengthFactor": 1.0,
        "labelDailyCapFlOz": 456.0,
        "mixFlOzPerGal": 1.164,
        "withinLabel": true
      }
    },
