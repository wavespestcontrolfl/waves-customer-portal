{
  "name": "waves-customer-portal",
  "version": "1.0.0",
  "description": "Customer portal for Waves Pest Control \u2014 Twilio SMS + Stripe Payments",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "packages/*",
    "video"
  ],
  "scripts": {
    "dev": "node scripts/dev/run.js app",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "prebuild": "npm run verify:blog-schema && npm run verify:affiliate-registry && npm run check:portal-brand && npm run check:domain-rules",
    "build": "cd client && npm run build",
    "check:portal-brand": "node scripts/check-portal-brand.js",
    "check:domain-rules": "node scripts/check-domain-rules.js",
    "prestart": "npm run verify:blog-schema && npm run verify:affiliate-registry",
    "start": "node server/index.js",
    "db:migrate": "npx knex migrate:latest --knexfile server/knexfile.js",
    "db:rollback": "npx knex migrate:rollback --knexfile server/knexfile.js",
    "db:seed": "npx knex seed:run --knexfile server/knexfile.js",
    "test": "cd server && npm test",
    "test:contracts": "node server/contract-tests/index.js",
    "test:contracts:list": "node server/contract-tests/index.js --list",
    "models:check": "node scripts/check-models.js",
    "seed:pricing": "node scripts/seed-local-pricing.js",
    "twilio:flow:export": "node scripts/twilio/export-studio-flow.js",
    "twilio:flow:verify": "node scripts/twilio/verify-studio-flow-contract.js",
    "twilio:inbound:audit": "node scripts/twilio/audit-inbound-routing.js",
    "twilio:inbound:set-url": "node scripts/twilio/set-inbound-voice-url.js",
    "smoke:lead-estimate-automation": "node server/scripts/smoke-lead-estimate-automation.js",
    "eval:lawn-diagnostic": "node server/scripts/run-lawn-diagnostic-eval.js",
    "check:lawn-models": "node server/scripts/check-lawn-model-readiness.js",
    "agent:export-fixtures": "node server/scripts/export-agent-decision-fixtures.js",
    "agent:export-reply-fixtures": "node server/scripts/export-reply-training-fixtures.js",
    "agent:evaluate-fixtures": "node server/scripts/evaluate-agent-decision-fixtures.js",
    "agent:replay-estimate-conversion": "node server/scripts/replay-estimate-conversion-agent.js",
    "eval:call-replay": "node server/scripts/run-call-extraction-replay-eval.js --json",
    "verify:blog-schema": "node packages/blog-schema/scripts/verify-vendor.js",
    "sync:blog-schema": "node packages/blog-schema/scripts/sync-from-astro.js",
    "sync:affiliate-registry": "node packages/affiliate-registry/scripts/sync-from-astro.js",
    "verify:affiliate-registry": "node packages/affiliate-registry/scripts/verify-vendor.js",
    "content:registry:live-status": "node server/scripts/check-content-registry-live-status.js",
    "content:registry:archive-stale": "node server/scripts/archive-stale-blog-rows.js",
    "backlink:sync-strategy-agent": "node scripts/create-backlink-strategy-agent.js",
    "seo:pipeline:run": "node server/scripts/run-seo-pipeline.js",
    "seo:pipeline:worker": "node server/scripts/run-seo-pipeline-worker.js",
    "audit:staff-rollout": "node server/scripts/audit-staff-rollout-readiness.js",
    "rotate:legacy-staff-passwords": "node server/scripts/rotate-legacy-staff-passwords.js",
    "audit:waveguard-materials": "node server/scripts/audit-waveguard-protocol-material-costs.js",
    "audit:estimate-previews": "node scripts/audit-estimate-previews.js",
    "prepare": "git config core.hooksPath scripts/hooks 2>/dev/null || true",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "lint:staged": "lint-staged",
    "dev:doctor": "node scripts/dev/doctor.js",
    "dev:debug": "node scripts/dev/run.js debug",
    "dev:managed-client": "node scripts/dev/run.js client",
    "dev:migrate": "node scripts/dev/run.js migrate",
    "worktree:create": "node scripts/dev/worktree.js create",
    "worktree:setup": "node scripts/dev/worktree.js setup",
    "worktree:status": "node scripts/dev/worktree.js status",
    "worktree:stop": "node scripts/dev/worktree.js stop",
    "test:dev-workflow": "node --test scripts/dev/tests/*.test.js",
    "qa:previews": "node scripts/qa/previews.js",
    "test:qa-workflow": "node --test scripts/qa/tests/*.test.js",
    "qa:e2e": "node scripts/qa/e2e.js",
    "qa:seed": "node scripts/qa/e2e.js --seed",
    "qa:cleanup": "node scripts/qa/e2e.js --cleanup",
    "qa:database": "node scripts/qa/database.js"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs}": "eslint --fix --cache --cache-location node_modules/.cache/eslint --no-warn-ignored"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "lint-staged": "^15.5.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@google-analytics/data": "^5.2.1",
    "@sentry/node": "^10.47.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "archiver": "^7.0.1",
    "csv-parse": "^6.2.1",
    "google-ads-api": "^23.0.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.2.18",
    "js-yaml": "^4.1.1",
    "nodemailer": "^8.0.4",
    "playwright": "^1.59.1",
    "psl": "^1.15.0",
    "sharp": "^0.34.5",
    "stripe": "^22.0.0",
    "ws": "^8.20.0"
  }
}
