{
  "manifest_version": 3,
  "name": "Bug Identifier – Insect & Spider ID by Waves",
  "short_name": "Bug ID",
  "version": "1.0.0",
  "description": "Identify bugs, spiders and insects from a photo or any image on the web. Free, from a licensed Florida pest control company.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Identify a bug",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://portal.wavespestcontrol.com/*"]
}
