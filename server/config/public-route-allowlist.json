{
  "_comment": [
    "Every router mount / route that is INTENTIONALLY reachable without",
    "authentication. AGENTS.md: \"New public routes outside this list are P0.\"",
    "server/tests/public-route-allowlist.test.js recomputes the real public",
    "surface from server/index.js and fails on any difference, in either",
    "direction. To add a legitimate public route: get owner review, then add it",
    "here with a reason. Identity is router file + mount path (never line",
    "numbers); route entries are METHOD + full path as the scanner prints them",
    "(node server/tests/route-surface/scan.js diffs the live surface)."
  ],
  "mounts": [
    {
      "router": "server/index.js",
      "mount": "/",
      "reason": "Pre-router middleware inventoried as USE surface: the global helmet CSP selector (embed vs strict headers, always next()s), embed-CORS + privacy header stamps (pest-forecast, secure-card), and unobservable-when-dark 404 gates (payer statements, lawn assessment, careers, pest identifier, AI content report, public MCP/A2A) — each either sets headers and next()s or 404s while its GATE_* is off",
      "routes": [
        "USE / (inline function)",
        "USE /api/ai/chat/report (inline function)",
        "USE /api/pay/statement (inline function)",
        "USE /api/public/a2a (inline function)",
        "USE /api/public/careers (inline function)",
        "USE /api/public/lawn-assessment (inline function)",
        "USE /api/public/mcp (inline function)",
        "USE /api/public/pest-forecast (inline function)",
        "USE /api/public/pest-identifier (inline function)",
        "USE /api/public/secure-card (inline function)"
      ]
    },
    {
      "router": "server/routes/stripe-webhook.js",
      "mount": "/api/stripe/webhook",
      "reason": "Stripe webhook — signature-verified in-handler (stripe.webhooks.constructEvent over the raw body; rejects when STRIPE_WEBHOOK_SECRET is unset)",
      "routes": [
        "POST /api/stripe/webhook"
      ]
    },
    {
      "router": "server/routes/webhooks-sendgrid.js",
      "mount": "/api/webhooks/sendgrid",
      "reason": "SendGrid event webhook — ECDSA signature over the raw body verified in-handler (x-twilio-email-event-webhook-signature)",
      "routes": [
        "POST /api/webhooks/sendgrid/events"
      ]
    },
    {
      "router": "server/routes/webhooks-resend.js",
      "mount": "/api/webhooks/resend",
      "reason": "Resend event webhook — Svix HMAC signature verified in-handler with a 5-minute replay window (RESEND_WEBHOOK_SECRET; fails closed when unset)",
      "routes": [
        "POST /api/webhooks/resend/events"
      ]
    },
    {
      "router": "server/index.js",
      "mount": "/",
      "reason": "App shell: SPA entry + catch-all, service worker, /api/health liveness, public /report + /recap + /estimate + /quote HTML pages, client static assets; /debug-sentry only registers when NODE_ENV !== production",
      "routes": [
        "GET /",
        "GET /*",
        "GET /api/health",
        "GET /debug-sentry",
        "GET /estimate",
        "GET /estimate/:token",
        "GET /quote",
        "GET /sw.js",
        "GET <re:^\\/recap\\/[a-f0-9]{32}\\/?$/i>",
        "GET <re:^\\/report\\/[a-f0-9]{32}\\/?$/i>",
        "STATIC / (clientBuild)",
        "STATIC / (path.join(__dirname, '..', 'client', 'public'))"
      ]
    },
    {
      "router": "server/routes/auth.js",
